/**
 * LegalTexts - 法律与说明文案
 */
export class LegalTexts {
  static userAgreement(): string {
    return '一、服务说明\n' +
      '心语食记是一款面向情侣的食谱与小空间互动应用。你可以浏览公开食谱、收藏与点赞，' +
      '登录后绑定另一半并使用情侣小空间（动态分享、待办任务、打卡与夸赞）。\n\n' +
      '二、账号与使用规范\n' +
      '1. 你应使用本人华为账号登录，妥善保管账号信息。\n' +
      '2. 不得上传违法、侵权、骚扰或不当内容。\n' +
      '3. 食谱内容仅供参考，请结合自身健康状况合理食用。\n\n' +
      '三、情侣空间\n' +
      '1. 情侣空间为 1:1 绑定，邀请码 7 天内有效。\n' +
      '2. 解绑后本机空间数据将被清除；接入云服务后将按隐私政策归档处理。\n\n' +
      '四、协议变更\n' +
      '我们可能更新本协议，更新后将通过应用内提示再次征得你的同意。';
  }

  static privacyPolicy(): string {
    return '一、我们收集的信息\n' +
      '1. 华为账号标识(UnionID)、昵称、头像：用于登录识别与展示。\n' +
      '2. 互动数据：收藏、点赞、空间动态、任务、打卡照片等，用于向你和绑定的另一半提供服务。\n' +
      '3. 设备本地数据：烹饪计时、偏好设置等，默认存储在本机。\n\n' +
      '二、信息的使用与存储\n' +
      '1. 当前版本以本机存储为主；接入华为云服务后，情侣空间数据将同步至云端。\n' +
      '2. 打卡照片压缩后存储；解绑时本机数据立即清除。\n' +
      '3. 我们不会将你的情侣空间内容用于公开展示或广告定向。\n\n' +
      '三、你的权利\n' +
      '1. 可在「设置」中退出登录、解绑情侣空间。\n' +
      '2. 可关闭互动提示音、做菜超时提醒等偏好。\n\n' +
      '四、联系我们\n' +
      '如有疑问，请通过应用内「关于心语食记」了解开发者信息。';
  }

  static aboutApp(): string {
    return '心语食记 v1.0.0\n\n一起做饭，慢慢生活。\n\n' +
