{
  "recipes": [
    {
      "id": "r_tangcu_paigu",
      "title": "糖醋排骨",
      "cover": "recipes/tangcu_paigu.jpg",
      "tags": ["下饭", "宴客"],
      "categories": ["big_dish", "festival"],
      "timeMinutes": 45,
      "difficulty": "medium",
      "servings": 2,
      "ingredients": [
        { "name": "肋排", "amount": "500g" },
        { "name": "冰糖", "amount": "40g" },
        { "name": "香醋", "amount": "3勺" },
        { "name": "生抽", "amount": "2勺" },
        { "name": "料酒", "amount": "2勺" },
        { "name": "姜", "amount": "3片" }
      ],
      "steps": [
        { "order": 1, "text": "排骨冷水下锅，加姜片和料酒焯水，撇去浮沫后捞出沥干。" },
        { "order": 2, "text": "锅中少油，下冰糖小火炒出焦糖色，冒小泡时下排骨翻炒上色。" },
        { "order": 3, "text": "加生抽、香醋、料酒翻匀，倒入没过排骨的热水。" },
        { "order": 4, "text": "大火烧开转小火焖25分钟，最后大火收汁至浓稠亮泽即可。" }
      ],
      "tips": "炒糖色时全程小火，颜色微微变红就下排骨，过头会发苦。"
    },
    {
      "id": "r_fanqie_chaodan",
      "title": "番茄炒蛋",
      "cover": "recipes/fanqie_chaodan.jpg",
      "tags": ["快手", "下饭"],
      "categories": ["simple_two", "quick_15"],
      "timeMinutes": 12,
      "difficulty": "easy",
      "servings": 2,
      "ingredients": [
        { "name": "番茄", "amount": "2个" },
        { "name": "鸡蛋", "amount": "3个" },
        { "name": "白糖", "amount": "1勺" },
        { "name": "盐", "amount": "适量" },
        { "name": "葱花", "amount": "少许" }
      ],
      "steps": [
        { "order": 1, "text": "鸡蛋打散加少许盐，番茄切块。" },
        { "order": 2, "text": "热油倒入蛋液，凝固后划散盛出备用。" },
        { "order": 3, "text": "锅中下番茄炒出汁，加白糖和盐调味。" },
        { "order": 4, "text": "倒回鸡蛋翻匀，撒葱花出锅。" }
      ],
      "tips": "加一勺白糖能中和番茄酸味，味道更柔和。"
    },
    {
      "id": "r_niupai",
      "title": "香煎黑椒牛排",
      "cover": "recipes/niupai.jpg",
      "tags": ["西式", "浪漫"],
      "categories": ["candlelight", "festival"],
      "timeMinutes": 25,
      "difficulty": "medium",
      "servings": 2,
      "ingredients": [
        { "name": "西冷牛排", "amount": "2块" },
        { "name": "黑胡椒", "amount": "适量" },
        { "name": "海盐", "amount": "适量" },
        { "name": "黄油", "amount": "20g" },
        { "name": "迷迭香", "amount": "2枝" }
      ],
      "steps": [
        { "order": 1, "text": "牛排提前30分钟室温回温，厨房纸吸干表面水分。" },
        { "order": 2, "text": "两面撒海盐和黑胡椒，热锅热油每面煎90秒形成焦壳。" },
        { "order": 3, "text": "转小火加黄油和迷迭香，用勺不断淋油增香。" },
        { "order": 4, "text": "取出静置5分钟再切，锁住肉汁。" }
      ],
      "tips": "静置这一步别省，能让肉汁回流，切开不流血水。"
    },
    {
