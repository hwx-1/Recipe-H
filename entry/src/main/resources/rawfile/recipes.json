        { "name": "豆瓣酱", "amount": "1勺" },
        { "name": "花椒粉", "amount": "适量" },
        { "name": "蒜末", "amount": "1勺" },
        { "name": "水淀粉", "amount": "适量" },
        { "name": "葱花", "amount": "少许" }
      ],
      "steps": [
        { "order": 1, "text": "豆腐切块，沸水加盐焯30秒去豆腥后捞出。" },
        { "order": 2, "text": "热油炒香蒜末和豆瓣酱出红油，加少量清水烧开。" },
        { "order": 3, "text": "下豆腐轻推煮3分钟，分次淋水淀粉勾芡。" },
        { "order": 4, "text": "撒花椒粉和葱花出锅。" }
      ],
      "tips": "推豆腐要用铲背轻推，避免碎块。"
    },
