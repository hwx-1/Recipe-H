        { "name": "鸡蛋", "amount": "2个" },
        { "name": "生菜", "amount": "2片" },
        { "name": "火腿", "amount": "2片" },
        { "name": "沙拉酱", "amount": "适量" }
      ],
      "steps": [
        { "order": 1, "text": "吐司微微烤热，鸡蛋煎成溏心或全熟。" },
        { "order": 2, "text": "吐司抹沙拉酱，依次铺生菜、火腿、煎蛋。" },
        { "order": 3, "text": "盖上另一片吐司，对角切开即可。" }
      ],
      "tips": "生菜要擦干水分，三明治才不会湿软。"
    },
    {
      "id": "r_paigu_tang",
      "title": "玉米排骨汤",
      "cover": "recipes/paigu_tang.jpg",
      "tags": ["滋补", "清甜"],
      "categories": ["soup", "big_dish"],
      "timeMinutes": 70,
      "difficulty": "easy",
      "servings": 2,
      "ingredients": [
        { "name": "排骨", "amount": "400g" },
        { "name": "玉米", "amount": "1根" },
        { "name": "胡萝卜", "amount": "1根" },
        { "name": "姜", "amount": "3片" },
        { "name": "盐", "amount": "适量" }
      ],
      "steps": [
        { "order": 1, "text": "排骨冷水焯去血沫，玉米和胡萝卜切块。" },
        { "order": 2, "text": "排骨与姜片下砂锅，加足量清水大火烧开。" },
        { "order": 3, "text": "转小火炖40分钟后下玉米胡萝卜，再炖20分钟。" },
        { "order": 4, "text": "出锅前加盐调味即可。" }
      ],
      "tips": "全程别频繁开盖，汤色更清、味更浓。"
    },
    {
